{
  "name": "post-unified-inbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "concurrently -k -n api,web \"npm:start:api\" \"npm:preview:web\"",
    "preview:web": "vite preview",
    "start:api": "tsx server/index.ts",
    "mail:cache:reset": "tsx server/rebuild-mail-cache.ts --reset-derived-cache",
    "mail:cache:resume": "tsx server/rebuild-mail-cache.ts --resume",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "html-entities": "^2.6.0",
    "lucide-react": "^0.542.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
